#* why false?  Disable strict engine checks to allow cypress@15 to install on Node 18.
# This matches existing production behavior and prevents the build from 
# failing during the pnpm resolution of DeckGL version overrides.
engine-strict=false
#* why this triggered now: 
# adding 'overrides' for DeckGL forced pnpm to re-resolve the full 
# dependency tree. this fresh check surfaced the Cypress Node 20 
# requirement that was previously ignored or cached in the old lockfile.

shamefully-hoist=true
ignore-scripts=false
ignoreDepScripts=false